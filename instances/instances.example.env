# Template for one instance of discord-bridge@.service.
#
# Copy to instances/<name>.env (chmod 600, gitignored — real values never
# committed), fill in, then:
#   sudo systemctl enable --now discord-bridge@<name>.service
#
# Every field here is the same as top-level .env.example — see that file for
# full comments on each variable, including the BACKEND=cli / openai_compatible
# vars if this instance isn't a Claude one. The only thing that matters for
# running multiple agents is that BRIDGE_SESSION_FILE (and usually
# CLAUDE_CONFIG_DIR, or the BACKEND-specific equivalent) differ between
# instances so they don't collide — different agents, different backends, or
# the same backend twice, all work the same way: a new instances/<name>.env.

DISCORD_BOT_TOKEN_FILE=~/.discord_bot_token
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_ALLOWED_USER_IDS=123456789012345678
#BACKEND=claude
# Use the full path, not just "claude" — systemd's PATH usually doesn't
# include ~/.local/bin, so the default (PATH lookup) fails under
# discord-bridge@.service even though it works fine run by hand.
CLAUDE_BIN=~/.local/bin/claude
#CLAUDE_MODEL=sonnet
#CLAUDE_CONFIG_DIR=~/.claude-<name>
BRIDGE_WORKDIR=~/workspace
BRIDGE_SESSION_FILE=~/discord-bridge/instances/<name>.session_id.txt
#BRIDGE_TIMEOUT_SECONDS=1200
