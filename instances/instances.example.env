# Template for one instance of discord-bridge@.service.
#
# Copy to instances/<name>.env (chmod 600, gitignored — real values never
# committed), fill in, then:
#   sudo systemctl enable --now discord-bridge@<name>.service
#
# Every field here is the same as top-level .env.example — see that file for
# full comments on each variable. The only thing that matters for running
# multiple agents is that BRIDGE_SESSION_FILE (and usually CLAUDE_CONFIG_DIR)
# differ between instances so they don't collide.

DISCORD_BOT_TOKEN_FILE=~/.discord_bot_token
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_ALLOWED_USER_IDS=123456789012345678
#CLAUDE_BIN=~/.local/bin/claude
#CLAUDE_CONFIG_DIR=~/.claude-<name>
BRIDGE_WORKDIR=~/workspace
BRIDGE_SESSION_FILE=~/discord-bridge/instances/<name>.session_id.txt
#BRIDGE_TIMEOUT_SECONDS=1200
