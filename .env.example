# Copy to .env, fill in, and either `set -a; source .env; set +a` before
# running bridge.py, or point systemd's EnvironmentFile= at it (see README).
# .env itself is gitignored — never commit real values.

# Where the bot token lives (chmod 600). Get the token from the Discord
# Developer Portal (Applications -> your app -> Bot -> Reset Token).
DISCORD_BOT_TOKEN_FILE=~/.discord_bot_token

# The one channel the bot listens in. Enable Developer Mode in Discord,
# then right-click the channel -> Copy Channel ID.
DISCORD_CHANNEL_ID=123456789012345678

# Comma-separated Discord user IDs allowed to command the bot. Everyone
# else's messages get a no-entry reaction and are never sent to Claude.
# Right-click a user -> Copy User ID.
DISCORD_ALLOWED_USER_IDS=123456789012345678,987654321098765432

# Path to the claude CLI. Defaults to "claude" (resolved from PATH).
#CLAUDE_BIN=/home/youruser/.local/bin/claude

# Strongly recommended if you also use `claude` interactively on this
# machine: a dedicated config dir gives the bot its own identity, history,
# and permissions.deny, instead of inheriting your everyday (usually much
# broader) permissions.allow. Left unset, it falls back to claude's own
# default (~/.claude) — i.e. whatever you already granted yourself.
#CLAUDE_CONFIG_DIR=~/.claude-mybot

# cwd for the claude subprocess. Left at $HOME, a relative-path tool call
# from a Discord-triggered prompt can read/write straight into your home
# directory — point this somewhere dedicated instead.
BRIDGE_WORKDIR=~/workspace

# Where the resumable session id is persisted between messages.
#BRIDGE_SESSION_FILE=~/discord-bridge/session_id.txt

# Seconds before a hung claude process is killed.
#BRIDGE_TIMEOUT_SECONDS=1200
