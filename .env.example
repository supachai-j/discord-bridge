# Copy to .env, fill in, and either `set -a; source .env; set +a` before
# running bridge.py, or point systemd's EnvironmentFile= at it (see README).
# .env itself is gitignored — never commit real values.

# Where the bot token lives (chmod 600). Get the token from the Discord
# Developer Portal (Applications -> your app -> Bot -> Reset Token).
DISCORD_BOT_TOKEN_FILE=~/.discord_bot_token

# The one channel the bot listens in. Enable Developer Mode in Discord,
# then right-click the channel -> Copy Channel ID.
DISCORD_CHANNEL_ID=123456789012345678

# Comma-separated Discord user IDs allowed to command the bot. Everyone
# else's messages get a no-entry reaction and are never sent to Claude.
# Right-click a user -> Copy User ID.
DISCORD_ALLOWED_USER_IDS=123456789012345678,987654321098765432

# Which backend answers messages. See README.md#backends and
# docs/decisions/0005-pluggable-backends.md.
#   claude            - claude -p --resume (default; the only backend with
#                       a real production deployment behind it)
#   cli               - another agentic CLI (codex, Gemini CLI, ...) — see
#                       the CLI_* vars below. Plaintext output only.
#   openai_compatible - a plain chat API (grok, GLM, a local model via
#                       Ollama/vLLM/llama.cpp, ...) — no file/shell tool
#                       access, see the OPENAI_COMPATIBLE_* vars below.
#BACKEND=claude

# --- BACKEND=claude ----------------------------------------------------

# Path to the claude CLI. Defaults to "claude" (resolved from PATH) — but
# systemd services run with a minimal PATH that usually does NOT include
# ~/.local/bin, so under systemd this almost always needs to be the full
# path (find yours with `which claude`), or you'll hit
# "[Errno 2] No such file or directory: 'claude'" the moment a message
# tries to spawn it. Running `bridge.py` directly at a shell for testing
# doesn't have this problem, which is why it's easy to miss.
CLAUDE_BIN=/home/youruser/.local/bin/claude

# Which model answers. Unset means whatever claude's own default is for
# this CLAUDE_CONFIG_DIR/account. Accepts an alias (opus, sonnet, fable)
# or a full model name — same values as `claude --model`.
#CLAUDE_MODEL=sonnet

# Automatic fallback if CLAUDE_MODEL is overloaded/unavailable.
#CLAUDE_FALLBACK_MODEL=sonnet

# Reasoning effort: low, medium, high, xhigh, or max. Unset means claude's
# own default. Any other value is rejected at startup (fail fast, not a
# silent fallback) — same as claude --effort.
#CLAUDE_EFFORT=high

# Strongly recommended if you also use `claude` interactively on this
# machine: a dedicated config dir gives the bot its own identity, history,
# and permissions.deny, instead of inheriting your everyday (usually much
# broader) permissions.allow. Left unset, it falls back to claude's own
# default (~/.claude) — i.e. whatever you already granted yourself.
#CLAUDE_CONFIG_DIR=~/.claude-mybot

# cwd for the claude subprocess. Left at $HOME, a relative-path tool call
# from a Discord-triggered prompt can read/write straight into your home
# directory — point this somewhere dedicated instead.
BRIDGE_WORKDIR=~/workspace

# Where the resumable session id is persisted between messages.
#BRIDGE_SESSION_FILE=~/discord-bridge/session_id.txt

# Seconds before a hung claude process is killed.
#BRIDGE_TIMEOUT_SECONDS=1200

# Log verbosity for both this file's own logger and discord.py's (DEBUG,
# INFO, WARNING, ERROR). DEBUG is very chatty — discord.py logs every
# gateway event at that level.
#BRIDGE_LOG_LEVEL=INFO

# --- BACKEND=cli ---------------------------------------------------------
# A generic adapter for another agentic CLI. Plaintext output only — no
# structured event parsing, since that format differs per tool and isn't
# something verified here without the CLI installed. Check the CLI's own
# --help before trusting these examples; CLI flags on fast-moving tools
# change. {prompt} is replaced with the Discord message as a single argv
# element (shlex-split otherwise, so quote literal spaces in fixed args).

#CLI_BIN=codex
#CLI_ARGS_NEW=exec {prompt}
# Optional. Leave unset if the CLI has no equivalent (e.g. Gemini CLI's
# headless mode as of this writing has no documented resume flag) — every
# message then starts a fresh, stateless conversation.
#CLI_ARGS_RESUME=exec resume --last {prompt}

# Gemini CLI equivalent (no resume support currently documented):
#CLI_BIN=gemini
#CLI_ARGS_NEW=-p {prompt}

# --- BACKEND=openai_compatible --------------------------------------------
# Any POST {base_url}/chat/completions endpoint using the standard OpenAI
# streaming wire format. Covers grok, GLM, and local models (Ollama/vLLM/
# llama.cpp all expose this same shape) — one backend, no per-vendor code.
# No file/shell tool access: this is a plain chat backend, not an agentic
# one.

# grok (x.ai):
#OPENAI_COMPATIBLE_BASE_URL=https://api.x.ai/v1
#OPENAI_COMPATIBLE_MODEL=grok-4

# GLM (Zhipu), OpenAI-compatible endpoint:
#OPENAI_COMPATIBLE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#OPENAI_COMPATIBLE_MODEL=glm-4.6

# Local via Ollama:
#OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#OPENAI_COMPATIBLE_MODEL=llama3.1
#OPENAI_COMPATIBLE_API_KEY_FILE=~/.ollama_dummy_key   # any non-empty file — Ollama ignores the value

# Path to a file containing just the API key (chmod 600), same pattern as
# DISCORD_BOT_TOKEN_FILE. Required whenever BACKEND=openai_compatible.
#OPENAI_COMPATIBLE_API_KEY_FILE=~/.openai_compatible_key

#OPENAI_COMPATIBLE_SYSTEM_PROMPT=You are a helpful assistant.

# How many prior messages (user+assistant turns) to keep in the request —
# stateless chat APIs have no server-side session, so this bounds both the
# request size and the token cost of a long conversation.
#OPENAI_COMPATIBLE_MAX_HISTORY=40
